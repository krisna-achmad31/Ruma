rules_version = '2';

// Aturan akses: satu rumah (families/{familyId}) hanya bisa dibaca dan diubah
// oleh anggotanya. Tempel isi file ini di Firebase Console, Firestore, tab Rules,
// atau deploy dengan: firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function myFamilyId() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.familyId;
    }

    function isMember(familyId) {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && myFamilyId() == familyId;
    }

    match /users/{uid} {
      // Diri sendiri, atau anggota rumah yang sama (untuk daftar anggota di Profil).
      allow read: if signedIn()
        && (request.auth.uid == uid || resource == null || resource.data.familyId == myFamilyId());
      allow create, update: if signedIn() && request.auth.uid == uid;
      allow delete: if false;
    }

    match /families/{familyId} {
      // Pengguna yang sudah masuk boleh membaca data dasar rumah, dipakai untuk
      // mencari rumah lewat kode undangan sebelum bergabung.
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.members == [request.auth.uid];
      allow update: if isMember(familyId)
        // Bergabung lewat kode: hanya boleh menambahkan dirinya ke members.
        || (signedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
          && request.resource.data.members.hasAll(resource.data.members)
          && request.resource.data.members.removeAll(resource.data.members) == [request.auth.uid]);
      allow delete: if false;

      // Semua subkoleksi rumah: dompet, transaksi, urusan, belanja, kalender, kita, dan lainnya.
      match /{document=**} {
        allow read, write: if isMember(familyId);
      }
    }
  }
}
